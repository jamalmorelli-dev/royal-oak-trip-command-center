# Server-only OpenAI key for the concierge route.
OPENAI_API_KEY=replace_with_your_key

# Private Travel Vault. NEVER prefix these with NEXT_PUBLIC_.
# Use a PIN the owner can enter on the phone and a separate high-entropy secret.
TRAVEL_VAULT_PIN=replace_with_private_pin
TRAVEL_VAULT_SECRET=replace_with_at_least_32_random_characters
